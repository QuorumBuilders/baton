# Copy this file to .env and set a unique, randomly generated secret key.
# Generate one with: uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# OTP verification limits (seconds for expiration and resend cooldown).
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# With DEBUG=True, delivery defaults to the development console backend.
# With DEBUG=False, delivery is disabled until a production SMS backend exists.
