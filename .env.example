# Copy this file to .env and set a unique, randomly generated secret key.
# Generate one with: uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# OTP verification limits (seconds for expiration and resend cooldown).
OTP_TTL_SECONDS=300
# Patient details can be completed for 30 minutes after successful verification.
PATIENT_REGISTRATION_TTL_SECONDS=1800
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# With DEBUG=True, SMS prints complete payloads and voice logs mock invocations.
# These defaults send no real SMS or phone calls. Both are disabled by default
# with DEBUG=False, and development adapters reject production use.
# SMS_DELIVERY_BACKEND=communications.adapters.ConsoleSMSAdapter
# VOICE_DELIVERY_BACKEND=communications.adapters.MockVoiceAdapter

# Verified project contact and general location; legal name and full address
# remain unverified and display as placeholders until supplied.
BATON_CONTACT_EMAIL=teamtensorcs@gmail.com
BATON_OPERATOR_LOCATION=Akure, Ondo, Nigeria
BATON_OPERATOR_NAME=
BATON_OPERATOR_ADDRESS=
